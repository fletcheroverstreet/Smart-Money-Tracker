{
  "name": "smt-web",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Money Tracker front end (Next.js). Reads the read-only API; holds no finance logic.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "gen:api": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "gen:openapi": "cd ../backend && uv run python -c \"import json;from smt.api.app import create_app;open('../web/src/lib/api/openapi.json','w',encoding='utf-8').write(json.dumps(create_app().openapi(),indent=1))\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "cmdk": "1.1.1",
    "echarts": "6.1.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
